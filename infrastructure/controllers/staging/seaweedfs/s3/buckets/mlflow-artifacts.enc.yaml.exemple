# PLACEHOLDER -- NOT ENCRYPTED YET. S3 credential for bucket mlflow-artifacts (asp repo: MLflow's
# proxied artifact store, k8s/charts/mlops mlflow.objectStore). Steps: ../README.md.
#   cp mlflow-artifacts.enc.yaml.exemple mlflow-artifacts.enc.yaml
#   # MLFLOW_ARTIFACTS_S3_ACCESS_KEY: openssl rand -hex 12
#   # MLFLOW_ARTIFACTS_S3_SECRET_KEY: openssl rand -hex 32
#   sops -e -i mlflow-artifacts.enc.yaml
apiVersion: v1
kind: Secret
metadata:
  name: s3-mlflow-artifacts
  namespace: flux-system
  annotations:
    # Reflector copies this Secret into the consuming namespace, so one file serves both
    # the identity (here) and the client (there).
    reflector.v1.k8s.emberstack.com/reflection-allowed: "true"
    reflector.v1.k8s.emberstack.com/reflection-allowed-namespaces: mlops
    reflector.v1.k8s.emberstack.com/reflection-auto-enabled: "true"
    reflector.v1.k8s.emberstack.com/reflection-auto-namespaces: mlops
type: Opaque
stringData:
  MLFLOW_ARTIFACTS_S3_ACCESS_KEY: "<openssl rand -hex 12>"
  MLFLOW_ARTIFACTS_S3_SECRET_KEY: "<openssl rand -hex 32>"
