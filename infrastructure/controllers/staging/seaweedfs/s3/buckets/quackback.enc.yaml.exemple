# PLACEHOLDER -- NOT ENCRYPTED YET. S3 credential for bucket quackback: Quackback's uploads (feedback
# screenshots, avatars). Consumer namespaces in quackback.reflection.yaml. Steps: ../README.md.
#   cp quackback.enc.yaml.exemple quackback.enc.yaml
#   # QUACKBACK_S3_ACCESS_KEY: openssl rand -hex 12
#   # QUACKBACK_S3_SECRET_KEY: openssl rand -hex 32
#   sops -e -i quackback.enc.yaml
apiVersion: v1
kind: Secret
metadata:
  name: s3-quackback
  namespace: flux-system
type: Opaque
stringData:
  QUACKBACK_S3_ACCESS_KEY: "<openssl rand -hex 12>"
  QUACKBACK_S3_SECRET_KEY: "<openssl rand -hex 32>"
