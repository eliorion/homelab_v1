# PLACEHOLDER -- NOT ENCRYPTED YET. S3 credential for bucket ml-lake-vision (asp repo docs/27 D8-D9: player
# photos archived by fbref-vision and the vision.* labels, GDPR Art. 9). Steps: ../README.md.
#   cp ml-lake-vision.enc.yaml.exemple ml-lake-vision.enc.yaml
#   # ML_LAKE_VISION_S3_ACCESS_KEY: openssl rand -hex 12
#   # ML_LAKE_VISION_S3_SECRET_KEY: openssl rand -hex 32
#   sops -e -i ml-lake-vision.enc.yaml      (.sops.yaml encrypts it with mac_only_encrypted)
# The namespaces that receive it are NOT here: ml-lake-vision.reflection.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: s3-ml-lake-vision
  namespace: flux-system
type: Opaque
stringData:
  ML_LAKE_VISION_S3_ACCESS_KEY: "<openssl rand -hex 12>"
  ML_LAKE_VISION_S3_SECRET_KEY: "<openssl rand -hex 32>"
