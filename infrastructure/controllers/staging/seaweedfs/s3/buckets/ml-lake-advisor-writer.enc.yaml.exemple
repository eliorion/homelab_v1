# PLACEHOLDER -- NOT ENCRYPTED YET. The advisor's WRITE-ONLY key on bucket ml-lake (asp docs/27 D10): the
# MOT backfill uploads each year's Parquet archive under advisor/ before it purges the staged rows.
#   cp ml-lake-advisor-writer.enc.yaml.exemple ml-lake-advisor-writer.enc.yaml
#   # ML_LAKE_ADVISOR_S3_ACCESS_KEY: openssl rand -hex 12
#   # ML_LAKE_ADVISOR_S3_SECRET_KEY: openssl rand -hex 32
#   sops -e -i ml-lake-advisor-writer.enc.yaml      (.sops.yaml encrypts it with mac_only_encrypted)
# The namespaces that receive it are NOT here: ml-lake-advisor-writer.reflection.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: s3-ml-lake-advisor
  namespace: flux-system
type: Opaque
stringData:
  ML_LAKE_ADVISOR_S3_ACCESS_KEY: "<openssl rand -hex 12>"
  ML_LAKE_ADVISOR_S3_SECRET_KEY: "<openssl rand -hex 32>"
