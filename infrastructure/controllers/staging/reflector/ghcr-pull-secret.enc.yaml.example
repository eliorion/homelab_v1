# TEMPLATE — copy to ghcr-pull-secret.enc.yaml, fill .dockerconfigjson, sops-encrypt (README.md).
# The *-namespaces lists are NOT here — they live in the plaintext
# ghcr-pull-secret-namespaces.yaml patch, so a new consumer namespace never touches this file.
apiVersion: v1
kind: Secret
metadata:
  name: ghcr-pull-secret
  namespace: reflector
  annotations:
    reflector.v1.k8s.emberstack.com/reflection-allowed: "true"
    reflector.v1.k8s.emberstack.com/reflection-auto-enabled: "true"
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: '{"auths":{"ghcr.io":{"auth":"REPLACE_BASE64_USER_COLON_PAT"}}}'
