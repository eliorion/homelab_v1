# TEMPLATE — the ONE central GHCR pull secret. Copy to ghcr-pull-secret.enc.yaml,
# put the REAL dockerconfigjson in .dockerconfigjson, then encrypt:
#
#   cd infrastructure/controllers/staging/reflector
#   cp ghcr-pull-secret.enc.yaml.example ghcr-pull-secret.enc.yaml
#   # reuse the same creds the per-project secrets had, e.g. build the value with:
#   #   kubectl create secret docker-registry ghcr-pull-secret \
#   #     --docker-server=ghcr.io --docker-username=<user> --docker-password=<PAT> \
#   #     --dry-run=client -o jsonpath='{.data.\.dockerconfigjson}'
#   sops --encrypt --in-place ghcr-pull-secret.enc.yaml   # staging age key, by path
#
# reflector mirrors it into every namespace in reflection-auto-namespaces. Add a
# new project = append its namespace to BOTH *-namespaces lists below (then
# re-encrypt) — that's the only edit, ever.
apiVersion: v1
kind: Secret
metadata:
  name: ghcr-pull-secret
  namespace: reflector
  annotations:
    reflector.v1.k8s.emberstack.com/reflection-allowed: "true"
    reflector.v1.k8s.emberstack.com/reflection-allowed-namespaces: "asp,fbref,lab"
    reflector.v1.k8s.emberstack.com/reflection-auto-enabled: "true"
    reflector.v1.k8s.emberstack.com/reflection-auto-namespaces: "asp,fbref,lab"
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: '{"auths":{"ghcr.io":{"auth":"REPLACE_BASE64_USER_COLON_PAT"}}}'
