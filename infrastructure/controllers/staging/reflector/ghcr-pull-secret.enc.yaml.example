# TEMPLATE — copy to ghcr-pull-secret.enc.yaml, fill .dockerconfigjson, sops-encrypt (README.md).
# A new consumer namespace must be appended to BOTH *-namespaces annotations below.
apiVersion: v1
kind: Secret
metadata:
  name: ghcr-pull-secret
  namespace: reflector
  annotations:
    reflector.v1.k8s.emberstack.com/reflection-allowed: "true"
    reflector.v1.k8s.emberstack.com/reflection-allowed-namespaces: "asp,fbref,lab,scraper"
    reflector.v1.k8s.emberstack.com/reflection-auto-enabled: "true"
    reflector.v1.k8s.emberstack.com/reflection-auto-namespaces: "asp,fbref,lab,scraper"
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: '{"auths":{"ghcr.io":{"auth":"REPLACE_BASE64_USER_COLON_PAT"}}}'
