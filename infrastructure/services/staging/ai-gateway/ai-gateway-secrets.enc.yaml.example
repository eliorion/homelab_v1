# Template for ai-gateway-secrets.enc.yaml. Fill the values, then:
#
#   cp ai-gateway-secrets.enc.yaml.example ai-gateway-secrets.enc.yaml
#   sops -e -i ai-gateway-secrets.enc.yaml     # .sops.yaml picks the staging age key
#
# The committed ai-gateway-secrets.enc.yaml ships with PLACEHOLDER values so the
# HelmRelease renders. The gateway will boot and serve /metrics, but every
# provider call 401s until the real keys are in. Replace them with:
#
#   sops ai-gateway-secrets.enc.yaml           # edit in place, re-encrypts on save
#
# Generate the one value you own:
#   BIFROST_ENCRYPTION_KEY: openssl rand -base64 32
#
# AI_GATEWAY_TOKEN is NOT generated here any more — virtual keys are created in
# the dashboard and this Secret mirrors the one clients use. See README.md
# "Bootstrap a fresh database".
#
# NEVER commit this .example with real values, and never move these Secrets into
# base/ — .sops.yaml only encrypts under staging/ and production/.
---
# Everything the gateway itself resolves via `env.NAME` in release.yaml.
# Stays in the ai-gateway namespace; never mirrored anywhere.
apiVersion: v1
kind: Secret
metadata:
  name: ai-gateway-providers
  namespace: ai-gateway
type: Opaque
stringData:
  # Only needed if a provider key is entered in the dashboard as the literal
  # string `env.ANTHROPIC_API_KEY` rather than a raw value — that is the option
  # that keeps SOPS as the system of record instead of the database. Drop the
  # ones you enter raw. Add a variable here per provider you onboard.
  ANTHROPIC_API_KEY: REPLACE_ME
  OPENAI_API_KEY: REPLACE_ME
  OPENROUTER_API_KEY: REPLACE_ME
  # Encrypts sensitive columns at rest in the gateway's own store, so the CNPG
  # backups hold ciphertext. Changing it after first boot makes the existing
  # store unreadable, and LOSING it makes every backup permanently
  # unrecoverable — treat as permanent, and keep it out of the backup's own
  # blast radius (which is why it lives here, in SOPS, and not in the DB).
  BIFROST_ENCRYPTION_KEY: REPLACE_ME
---
# Dashboard / management-API login. Not used for inference.
apiVersion: v1
kind: Secret
metadata:
  name: ai-gateway-admin
  namespace: ai-gateway
type: Opaque
stringData:
  username: admin
  password: REPLACE_ME
---
# The CLIENT-facing half of the contract, under a provider-neutral key name.
# Consumers reference AI_GATEWAY_TOKEN and never learn what backend issued it.
# Its value is a virtual key CREATED IN THE DASHBOARD and copied here, so this
# Secret is a mirror rather than a source — the gateway reads its own virtual
# keys from Postgres, not from here. Kept as a separate Secret so the one that
# holds provider keys never leaves the ai-gateway namespace.
apiVersion: v1
kind: Secret
metadata:
  name: ai-gateway-token
  namespace: ai-gateway
  annotations:
    reflector.v1.k8s.emberstack.com/reflection-allowed: "true"
    reflector.v1.k8s.emberstack.com/reflection-allowed-namespaces: asp,fbref,lab,scraper
    reflector.v1.k8s.emberstack.com/reflection-auto-enabled: "true"
    reflector.v1.k8s.emberstack.com/reflection-auto-namespaces: asp,fbref,lab,scraper
type: Opaque
stringData:
  AI_GATEWAY_TOKEN: REPLACE_ME
