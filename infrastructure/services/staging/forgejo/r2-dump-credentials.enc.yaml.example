# TEMPLATE — the R2 token the forgejo-dump CronJob uploads with.
# The token MUST be scoped to `forgejo-dump-staging` only (Object Read & Write), and the filled
# copy MUST be sops-encrypted (.sops.yaml matches `staging/*.enc.yaml`).
apiVersion: v1
kind: Secret
metadata:
  name: r2-dump-credentials
  namespace: forgejo
type: Opaque
stringData:
  ACCESS_KEY_ID: REPLACE_WITH_R2_ACCESS_KEY_ID
  ACCESS_KEY_SECRET: REPLACE_WITH_R2_SECRET_ACCESS_KEY
