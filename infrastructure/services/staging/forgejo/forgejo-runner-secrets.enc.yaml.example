# TEMPLATE — one 40-hex shared secret per runner (runner-0..runner-3), the StatefulSet's ordinals.
# The Forgejo bootstrap sidecar registers each (`forgejo-cli actions register --secret`) and runner
# pod N connects with key runner-N; reflector mirrors this Secret into forgejo-runners. Rotating a
# value = a new runner identity: delete the old runner in Forgejo's admin UI afterwards.
apiVersion: v1
kind: Secret
metadata:
  name: forgejo-runner-secrets
  namespace: forgejo
  annotations:
    reflector.v1.k8s.emberstack.com/reflection-allowed: "true"
    reflector.v1.k8s.emberstack.com/reflection-allowed-namespaces: "forgejo-runners"
    reflector.v1.k8s.emberstack.com/reflection-auto-enabled: "true"
    reflector.v1.k8s.emberstack.com/reflection-auto-namespaces: "forgejo-runners"
type: Opaque
stringData:
  # openssl rand -hex 20, four times
  runner-0: REPLACE_WITH_40_HEX
  runner-1: REPLACE_WITH_40_HEX
  runner-2: REPLACE_WITH_40_HEX
  runner-3: REPLACE_WITH_40_HEX
