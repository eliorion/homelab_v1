# Template for homepage-secrets.enc.yaml — see base/homepage/README.md, "Filling the Secret".
#
#   cp homepage-secrets.enc.yaml.example homepage-secrets.enc.yaml
#   sops -e -i homepage-secrets.enc.yaml     # .sops.yaml picks the staging age key
#
# NEVER commit this .example with real values.
apiVersion: v1
kind: Secret
metadata:
  name: homepage-secrets
  namespace: homepage
type: Opaque
stringData:
  HOMEPAGE_VAR_CF_ACCOUNT_ID: REPLACE_ME
  HOMEPAGE_VAR_CF_TUNNEL_ID: REPLACE_ME
  # Cloudflare API token, permission Account › Cloudflare Tunnel › Read only.
  HOMEPAGE_VAR_CF_API_TOKEN: REPLACE_ME
  # Tailscale API access token (tskey-api-…). Expires after at most 90 days.
  HOMEPAGE_VAR_TAILSCALE_API_KEY: REPLACE_ME
