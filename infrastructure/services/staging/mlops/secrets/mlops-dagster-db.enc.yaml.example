# PLACEHOLDER -- NOT ENCRYPTED. Template for mlops-dagster-db.enc.yaml (the dagster role of mlops-db):
#   cp mlops-dagster-db.enc.yaml.example mlops-dagster-db.enc.yaml
#   # password and postgresql-password: the SAME value, openssl rand -hex 32
#   sops -e -i mlops-dagster-db.enc.yaml
apiVersion: v1
kind: Secret
metadata:
  name: mlops-dagster-db
  labels:
    cnpg.io/reload: "true"
type: kubernetes.io/basic-auth
stringData:
  username: dagster
  password: "<openssl rand -hex 32>"
  postgresql-password: "<the same value as password>"
