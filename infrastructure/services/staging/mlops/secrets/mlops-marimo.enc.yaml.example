# TEMPLATE — the in-cluster marimo notebook's access token (asp docs/27 P11). It is asked before a
# session opens, on top of the tailnet (Ingress `marimo`, ../../../base/mlops/ingress-tailscale.yaml).
#
# .sops.yaml selects the age key by PATH (`staging/*.enc.yaml`), so `.example` matches nothing and is
# never encrypted — NEVER put a real token here. To rotate:
#   cp mlops-marimo.enc.yaml.example mlops-marimo.enc.yaml
#   # token: openssl rand -hex 24
#   sops -e -i mlops-marimo.enc.yaml
# Read it to log in: sops -d mlops-marimo.enc.yaml (or open marimo.<tailnet>/?access_token=<token>).
apiVersion: v1
kind: Secret
metadata:
  name: mlops-marimo
  namespace: mlops
type: Opaque
stringData:
  token: REPLACE_WITH_OPENSSL_RAND_HEX_24
