# TEMPLATE — the Cloudflare Access OIDC client credential for the `apps` realm.
# Filling it in: ../../../base/keycloak/README.md
#
# .sops.yaml selects the age key by PATH (`staging/*.enc.yaml`), so `.example`
# matches nothing and is never encrypted — NEVER put the real secret here.
# Changing either value requires re-running the import by hand: the ConfigMap
# hash does not change when only this Secret does.
apiVersion: v1
kind: Secret
metadata:
  name: cloudflare-access-client
  namespace: identity
type: Opaque
stringData:
  # Generated here, NOT by Keycloak, and entered by hand in Zero Trust → Settings
  # → Authentication. The same value must be on both sides.
  client-secret: REPLACE_WITH_OPENSSL_RAND_BASE64_32
  # https://<team-name>.cloudflareaccess.com — WITH scheme, NO trailing slash.
  # Keycloak matches redirect URIs textually; either mistake rejects every
  # callback with "Invalid parameter: redirect_uri".
  team-domain: https://REPLACE_WITH_TEAM_NAME.cloudflareaccess.com
