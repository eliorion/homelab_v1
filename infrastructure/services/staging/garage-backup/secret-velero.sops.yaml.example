# TEMPLATE — PLAINTEXT PLACEHOLDERS, NOT A REAL SECRET. DO NOT COMMIT FILLED-IN.
#
#   cp secret-velero.sops.yaml.example secret-velero.enc.yaml
#   # fill the placeholders below with real values, then encrypt IN PLACE:
#   sops -e -i secret-velero.enc.yaml
#   # finally add `- secret-velero.enc.yaml` to kustomization.yaml resources.
#
# The .enc.yaml name + this staging/ path make .sops.yaml auto-select the staging
# age recipient (age137z0k…szh5ng3) with encrypted_regex ^(data|stringData)$.
# Decryption happens only via the parent garage-backup Flux Kustomization's
# decryption.provider: sops (WIRING). NEVER commit the plaintext .enc.yaml.
#
# Velero S3 credentials for the Garage `velero` write key (write grant on the
# velero bucket). Created on the Garage side with:
#   garage bucket create velero
#   garage key create velero-writer
#   garage bucket allow --read --write velero --key velero-writer
#
# Referenced by BOTH the Velero HelmRelease (credentials.existingSecret) and the
# BackupStorageLocation (spec.credential). Velero reads an AWS shared-credentials
# *file*, so the value under `cloud` is INI-format, not bare key/secret.
#
# NOTE: the Velero/Kopia repository password (which actually encrypts the PVC
# payload client-side) is a break-glass item kept offline in two physical
# locations (doc 09 §8); Velero manages the per-BSL repo password itself, so it
# is NOT placed in this Secret — only the S3 access creds are.
apiVersion: v1
kind: Secret
metadata:
  name: velero-garage-credentials
  namespace: backup
stringData:
  cloud: |
    [default]
    aws_access_key_id = REPLACE_WITH_GARAGE_VELERO_WRITER_ACCESS_KEY_ID
    aws_secret_access_key = REPLACE_WITH_GARAGE_VELERO_WRITER_SECRET_ACCESS_KEY
