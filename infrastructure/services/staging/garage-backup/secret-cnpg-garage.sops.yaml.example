# TEMPLATE — PLAINTEXT PLACEHOLDERS, NOT A REAL SECRET. DO NOT COMMIT FILLED-IN.
#
#   cp secret-cnpg-garage.sops.yaml.example secret-cnpg-garage.enc.yaml
#   # fill the placeholders below with real values, then encrypt IN PLACE:
#   sops -e -i secret-cnpg-garage.enc.yaml
#   # finally add `- secret-cnpg-garage.enc.yaml` to kustomization.yaml resources.
#
# The .enc.yaml name + this staging/ path make .sops.yaml auto-select the staging
# age recipient (age137z0k…szh5ng3) with encrypted_regex ^(data|stringData)$.
# Decryption happens only via the parent garage-backup Flux Kustomization's
# decryption.provider: sops. NEVER commit the plaintext .enc.yaml.
#
# S3 credentials for the CNPG ObjectStore `garage-store` (cnpg-garage-backup.yaml).
# Created on the Garage side with:
#   garage bucket create cnpg-staging
#   garage key create cnpg-base-writer
#   garage bucket allow --read --write cnpg-staging --key cnpg-base-writer
#
# ⚠️ NAMESPACE asp (NOT backup): the CNPG ObjectStore/ScheduledBackup are
#    namespace-scoped to the asp-db Cluster, which lives in ns asp (the live
#    production-data namespace). This Secret MUST be in asp so the ObjectStore can
#    reference it. The rest of the component lives in ns backup.
#
# ⚠️ KEY NAMES differ from the etcd creds Secret on purpose — they must match the
#    ObjectStore.spec.configuration.s3Credentials reference EXACTLY:
#      ACCESS_KEY_ID      (NOT AWS_ACCESS_KEY_ID)
#      ACCESS_KEY_SECRET  (NOT AWS_SECRET_ACCESS_KEY)
#    The etcd CronJob reads the AWS_* form; CNPG's barman plugin reads these.
apiVersion: v1
kind: Secret
metadata:
  name: garage-cnpg-credentials
  namespace: asp
stringData:
  ACCESS_KEY_ID: "REPLACE_WITH_GARAGE_CNPG_WRITER_ACCESS_KEY_ID"
  ACCESS_KEY_SECRET: "REPLACE_WITH_GARAGE_CNPG_WRITER_SECRET_ACCESS_KEY"
