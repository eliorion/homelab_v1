# TEMPLATE — PLAINTEXT PLACEHOLDERS, NOT A REAL SECRET. DO NOT COMMIT FILLED-IN.
#
#   cp secret-etcd-backup.sops.yaml.example secret-etcd-backup.enc.yaml
#   # fill the placeholders below with real values, then encrypt IN PLACE:
#   sops -e -i secret-etcd-backup.enc.yaml
#   # finally add `- secret-etcd-backup.enc.yaml` to kustomization.yaml resources.
#
# The .enc.yaml name + this staging/ path make .sops.yaml auto-select the staging
# age recipient (age137z0k…szh5ng3) with encrypted_regex ^(data|stringData)$.
# Decryption happens only via the parent garage-backup Flux Kustomization's
# decryption.provider: sops (WIRING). NEVER commit the plaintext .enc.yaml.
#
# Three Secrets feed the etcd-backup CronJob (base/garage-backup/etcd-backup-cronjob.yaml):
---
# (1) Garage S3 credentials for the `etcd-backup-writer` key (write grant on the
# etcd-snapshots bucket). Created on the Garage side with:
#   garage bucket create etcd-snapshots
#   garage key create etcd-backup-writer
#   garage bucket allow --read --write etcd-snapshots --key etcd-backup-writer
apiVersion: v1
kind: Secret
metadata:
  name: garage-etcd-credentials
  namespace: backup
stringData:
  AWS_ACCESS_KEY_ID: "REPLACE_WITH_GARAGE_ETCD_WRITER_ACCESS_KEY_ID"
  AWS_SECRET_ACCESS_KEY: "REPLACE_WITH_GARAGE_ETCD_WRITER_SECRET_ACCESS_KEY"
---
# (2) Client-side encryption recipient — the talos-backup age PUBLIC key. The age
# PRIVATE key is break-glass: store offline, out-of-band, in two physical
# locations (doc 09 §8). The public key is non-secret but kept with its pair.
# Generate the pair OFFLINE:  age-keygen -o etcd-backup-age.key  (the "public
# key:" line is the value below; keep etcd-backup-age.key in break-glass custody).
apiVersion: v1
kind: Secret
metadata:
  name: etcd-backup-age
  namespace: backup
stringData:
  pub: "age1REPLACE_WITH_TALOS_BACKUP_AGE_PUBLIC_KEY"
---
# (3) Scoped Talos client config (os:etcd:backup ROLE ONLY — never os:admin).
# Mint it AFTER kubernetesTalosAPIAccess is live (doc 10 Phase 4a):
#   talosctl config new --roles=os:etcd:backup etcd-backuper
# then paste the rendered talosconfig YAML below (it is the file talos-backup
# mounts at /var/run/secrets/talos.dev).
apiVersion: v1
kind: Secret
metadata:
  name: etcd-backup-talosconfig
  namespace: backup
stringData:
  config: |
    REPLACE_WITH_SCOPED_TALOSCONFIG_YAML  # os:etcd:backup role, never os:admin
