# TEMPLATE — nao's session-signing key. Fill the value, then:
#
#   cd infrastructure/services/staging/databases/dbtools
#   cp nao-secrets.enc.yaml.example nao-secrets.enc.yaml
#   openssl rand -base64 32          # paste as better-auth-secret
#   sops --encrypt --in-place nao-secrets.enc.yaml
#
# .sops.yaml selects the age key by PATH (`staging/*.enc.yaml`), so `.example`
# matches nothing and is never encrypted — NEVER put the real key here.
#
# Read an existing one back with:
#   sops -d infrastructure/services/staging/dbtools/nao-secrets.enc.yaml
#
# Generated ONCE and it MUST stay stable: better-auth signs every session with
# it, so a new value logs every user out on the next rollout. It is derived from
# nothing, so losing it costs a re-login and nothing more.
#
# There is deliberately NO LLM key here — nao authenticates to ai-gateway with
# its own virtual key in nao-ai-gateway-token.enc.yaml, so that credential can
# be revoked without touching sessions.
apiVersion: v1
kind: Secret
metadata:
  name: nao-secrets
  namespace: database
type: Opaque
stringData:
  better-auth-secret: REPLACE_WITH_OPENSSL_RAND_BASE64_32
