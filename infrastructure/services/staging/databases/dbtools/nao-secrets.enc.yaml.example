# TEMPLATE — nao's session-signing key (`openssl rand -base64 32`). Procedure
# in README.md.
#
# .sops.yaml selects the age key by PATH (`staging/*.enc.yaml`), so `.example`
# matches nothing and is never encrypted — NEVER put the real key here.
#
# Generated ONCE and it MUST stay stable: a new value logs every user out on the
# next rollout. NO LLM key belongs here — that is nao-ai-gateway-token.enc.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: nao-secrets
  namespace: database
type: Opaque
stringData:
  better-auth-secret: REPLACE_WITH_OPENSSL_RAND_BASE64_32
