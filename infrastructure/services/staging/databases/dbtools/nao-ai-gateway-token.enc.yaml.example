# TEMPLATE — nao's OWN ai-gateway virtual key. Procedure in README.md.
#
# .sops.yaml selects the age key by PATH (`staging/*.enc.yaml`), so `.example`
# matches nothing and is never encrypted — NEVER put the real key here.
#
# The key is CREATED IN THE AI-GATEWAY DASHBOARD (Virtual Keys) and only stored
# here — nothing generates it locally.
apiVersion: v1
kind: Secret
metadata:
  name: nao-ai-gateway-token
  namespace: database
type: Opaque
stringData:
  AI_GATEWAY_TOKEN: REPLACE_WITH_AI_GATEWAY_VIRTUAL_KEY
