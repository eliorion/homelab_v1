# TEMPLATE — pgAdmin's own login (server mode). Procedure in README.md.
#
# .sops.yaml selects the age key by PATH (`staging/*.enc.yaml`), so `.example`
# matches nothing and is never encrypted — NEVER put a real password here.
#
# The email is not cosmetic: it names the pgpass storage directory and owns the
# once-per-user servers.json import. Changing it breaks both.
apiVersion: v1
kind: Secret
metadata:
  name: pgadmin-admin
  namespace: database
type: Opaque
stringData:
  email: REPLACE_WITH_LOGIN_EMAIL
  password: REPLACE_WITH_LOGIN_PASSWORD
