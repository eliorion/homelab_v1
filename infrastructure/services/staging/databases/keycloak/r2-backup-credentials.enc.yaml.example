# TEMPLATE — the R2 token CNPG uses to archive keycloak-db.
# The token MUST be scoped to `keycloak-cnpg-staging` only, and the filled copy
# MUST be sops-encrypted (.sops.yaml matches `staging/*.enc.yaml`).
# Full procedure: ../../../base/databases/README.md
apiVersion: v1
kind: Secret
metadata:
  name: r2-backup-credentials
type: Opaque
stringData:
  ACCESS_KEY_ID: REPLACE_WITH_R2_ACCESS_KEY_ID
  ACCESS_KEY_SECRET: REPLACE_WITH_R2_SECRET_ACCESS_KEY
