# TEMPLATE — Garage key for the ai-gateway CNPG backups.
# DEDICATED bucket + DEDICATED key: do not reuse fbref's bucket or its
# `garage-backup-credentials`. Do not list this file in kustomization.yaml before
# the real one exists — a missing resource breaks `kubectl kustomize`. The filled
# copy MUST be sops-encrypted (.sops.yaml matches `staging/*.enc.yaml`).
# Full procedure: ../../../base/databases/README.md
apiVersion: v1
kind: Secret
metadata:
  name: ai-gateway-garage-backup-credentials
  namespace: ai-gateway
type: Opaque
stringData:
  ACCESS_KEY_ID: REPLACE_WITH_GARAGE_KEY_ID
  ACCESS_KEY_SECRET: REPLACE_WITH_GARAGE_KEY_SECRET
