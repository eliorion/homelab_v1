# TEMPLATE — Garage key for the ai-gateway CNPG backups.
#
# Same Garage endpoint fbref-db uses, but a DEDICATED bucket + DEDICATED key —
# do not reuse fbref's `garage-backup-credentials` or its bucket. The etcd key
# does not have ai-gateway access either. Until the real credential exists,
# leave this file out of kustomization.yaml: listing a resource that doesn't
# exist breaks `kubectl kustomize`, and listing the ObjectStore/ScheduledBackup
# without it is fine — CNPG just reports the ScheduledBackup as failing,
# visibly (same behavior fbref-db's own template documents).
#
#   1. garage bucket create cnpg-staging-ai-gateway
#   2. garage key create ai-gateway-cnpg-staging
#   3. garage bucket allow --read --write cnpg-staging-ai-gateway \
#        --key ai-gateway-cnpg-staging
#   4. Fill and encrypt:
#
#        cd infrastructure/services/staging/databases/ai-gateway
#        cp ai-gateway-garage-backup-credentials.enc.yaml.example ai-gateway-garage-backup-credentials.enc.yaml
#        # paste the two values below, then:
#        sops --encrypt --in-place ai-gateway-garage-backup-credentials.enc.yaml
#
#      The staging age key is selected by path (.sops.yaml, `staging/*.enc.yaml`).
#      Encrypting is not optional — an unencrypted match of that path pattern is
#      a live Garage key in git history.
#   5. Add `ai-gateway-garage-backup-credentials.enc.yaml` to this overlay's
#      kustomization.yaml resources list.
#
#   6. Verify after Flux reconciles and the first ScheduledBackup runs:
#
#        kubectl -n ai-gateway get backup
#        kubectl -n ai-gateway exec ai-gateway-db-1 -c plugin-barman-cloud -- \
#          barman-cloud-backup-list --cloud-provider aws-s3 \
#          s3://cnpg-staging-ai-gateway ai-gateway-db
apiVersion: v1
kind: Secret
metadata:
  name: ai-gateway-garage-backup-credentials
  namespace: ai-gateway
type: Opaque
stringData:
  ACCESS_KEY_ID: REPLACE_WITH_GARAGE_KEY_ID
  ACCESS_KEY_SECRET: REPLACE_WITH_GARAGE_KEY_SECRET
