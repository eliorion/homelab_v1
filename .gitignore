*.envrc
# Relay credentials live in scripts/azuracast-relay/.env (admin/source/relay
# passwords). Only .env.example is committed.
.env
# Blanket catch-all for kubeconfig/service-account style JSON credentials.
*.json
# ...except the n8n workflow import templates, which carry no secrets (the
# credential is referenced by id/name only). Without this negation a re-exported
# workflow silently fails to commit. NEVER export n8n credentials themselves.
!documentations/n8n-workflows/*.json
# ...and the zot / Dagger Engine config files, which are kustomize
# configMapGenerator inputs. They carry no secrets (credentials live in the
# sops-encrypted Secrets beside them). Without these negations the blanket
# *.json rule drops them from the commit and the Flux build fails on a
# missing generator input -- silently, at apply time.
!infrastructure/services/base/zot/config/*.json
!infrastructure/services/base/dagger/config/*.json
key.txt
*.pem
kubeconfig*
*.agekey
tls.*
*.DS_Store
graphify-out/.graphify_*
graphify-out/cache/
# Talos machine configs + talosconfig embed cluster CA keys/secrets
bootstraping/controlplane.yaml
bootstraping/controlplane-*.yaml
bootstraping/worker.yaml
bootstraping/talosconfig
# talhelper: plaintext secret + rendered configs (talsecret.sops.yaml IS committed)
bootstraping/talsecret.yaml
bootstraping/clusterconfig/
# dead helm render from the rejected inlineManifest approach (embeds a Hubble CA)
cilium-indented.yaml
.claude/worktrees/
