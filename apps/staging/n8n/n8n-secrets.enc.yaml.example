# TEMPLATE — NOT ENCRYPTED. Never applied; copy it, fill it in, then
# `sops -e -i` the copy (staging age key, see ../../../.sops.yaml).
#
# NEVER ROTATE N8N_ENCRYPTION_KEY: it encrypts every credential n8n stores in
# n8n-db, and a database restore without this exact key is worthless.
# See ../../base/n8n/README.md.
apiVersion: v1
kind: Secret
metadata:
  name: n8n-secrets
  namespace: n8n
type: Opaque
stringData:
  N8N_ENCRYPTION_KEY: "<openssl rand -hex 32>"
