# TEMPLATE — NOT ENCRYPTED. Create the real file before pushing, or the `apps`
# Flux Kustomization fails its build and stalls (nothing pruned, no outage —
# same deliberate behaviour as the reflector secret).
#
#   cd apps/staging/n8n
#   cp n8n-secrets.enc.yaml.example n8n-secrets.enc.yaml
#   # put the output of `openssl rand -hex 32` in N8N_ENCRYPTION_KEY
#   sops -e -i n8n-secrets.enc.yaml        # staging age key, see ../../../.sops.yaml
#
# ############################################################################
# N8N_ENCRYPTION_KEY IS THE MOST IMPORTANT SECRET IN THIS REPO AFTER talsecret.
#
# It encrypts every credential n8n stores (LinkedIn token, future API keys) in
# the n8n-db Postgres. Change it — or reinstall and let n8n generate a new one —
# and every credential in every workflow becomes permanently unreadable. A
# database restore WITHOUT this exact key is worthless. NEVER rotate it.
# ############################################################################
apiVersion: v1
kind: Secret
metadata:
  name: n8n-secrets
  namespace: n8n
type: Opaque
stringData:
  N8N_ENCRYPTION_KEY: "<openssl rand -hex 32>"
