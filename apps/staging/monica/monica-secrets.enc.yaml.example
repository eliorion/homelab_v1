# TEMPLATE — NOT ENCRYPTED. Never applied; copy it, fill it in, then
# `sops -e -i` the copy (staging age key, see ../../../.sops.yaml):
#   cp monica-secrets.enc.yaml.example monica-secrets.enc.yaml
#   $EDITOR monica-secrets.enc.yaml && sops -e -i monica-secrets.enc.yaml
#
# The Secret NAME must stay `monica`: the chart hardcodes
# `secretKeyRef: {name: <fullname>, key: appkey}` for APP_KEY and ignores
# `monica.existingSecret.secretName`, and fullnameOverride is `monica`.
#
# NEVER ROTATE appkey: it is the Laravel APP_KEY that encrypts columns in
# monica-db, and a database restore without this exact value is worthless.
# See ../../base/monica/README.md.
#
# smtp-* are read only when `monica.mail.enabled` is flipped true in
# ../../base/monica/release.yaml; harmless to pre-stage.
apiVersion: v1
kind: Secret
metadata:
  name: monica
  namespace: monica
type: Opaque
stringData:
  # Exactly 32 characters, or a `base64:`-prefixed 32-byte key:
  #   openssl rand -hex 16
  #   printf 'base64:%s' "$(openssl rand -base64 32)"
  appkey: "<openssl rand -hex 16>"
  smtp-username: ""
  smtp-password: ""
