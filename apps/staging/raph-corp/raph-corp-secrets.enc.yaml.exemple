# PLACEHOLDER -- NOT ENCRYPTED YET, and not applied: kustomization.yaml does not
# list it. The chart mounts this Secret with `optional: true`, so the app runs
# without it (public OSRM routing, manual vehicle entry).
#
# HOW TO TURN THIS INTO THE REAL FILE
#   cp apps/staging/raph-corp/raph-corp-secrets.enc.yaml.exemple \
#      apps/staging/raph-corp/raph-corp-secrets.enc.yaml
#   # fill the keys, then:
#   sops -e -i apps/staging/raph-corp/raph-corp-secrets.enc.yaml
#   # and add `- raph-corp-secrets.enc.yaml` to kustomization.yaml resources.
# .sops.yaml already matches `(^|/)staging/.*\.enc\.ya?ml$`.
#
# To use openrouteservice instead of the public OSRM demo, also set
# `app.config.ROUTING_PROVIDER: ors` in release.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: raph-corp-secrets
  namespace: raph-corp
type: Opaque
stringData:
  ORS_API_KEY: "<openrouteservice key>"
  PLATE_LOOKUP_KEY: "<paid plate-lookup key, optional>"
