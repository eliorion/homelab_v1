# PLACEHOLDER -- NOT ENCRYPTED YET. Garage key for the nextcloud CNPG backups.
# No existing key has access to this bucket -- create a dedicated bucket + key
# (commands in apps/base/databases/nextcloud/README.md), then encrypt in place:
#   sops -e -i <this file>
apiVersion: v1
kind: Secret
metadata:
  name: garage-backup-credentials
type: Opaque
stringData:
  ACCESS_KEY_ID: "<garage key id>"
  ACCESS_KEY_SECRET: "<garage secret key>"
