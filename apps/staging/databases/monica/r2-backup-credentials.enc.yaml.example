# TEMPLATE — NOT ENCRYPTED, never applied. The R2 token CNPG uses to archive
# monica-db. The token MUST be scoped to `monica-cnpg-staging` only, and the
# filled copy MUST be sops-encrypted (.sops.yaml matches `staging/*.enc.yaml`):
#   cp r2-backup-credentials.enc.yaml.example r2-backup-credentials.enc.yaml
#   $EDITOR r2-backup-credentials.enc.yaml && sops -e -i r2-backup-credentials.enc.yaml
# Full procedure: ../../../../infrastructure/services/base/databases/README.md
apiVersion: v1
kind: Secret
metadata:
  name: r2-backup-credentials
  namespace: monica
type: Opaque
stringData:
  ACCESS_KEY_ID: REPLACE_WITH_R2_ACCESS_KEY_ID
  ACCESS_KEY_SECRET: REPLACE_WITH_R2_SECRET_ACCESS_KEY
