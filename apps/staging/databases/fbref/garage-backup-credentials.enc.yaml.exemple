# PLACEHOLDER -- NOT ENCRYPTED YET. Garage key for the fbref CNPG backups.
# The etcd key does NOT have fbref access -- create a dedicated bucket + key:
#   garage bucket create homelab-staging-fbref
#   garage key create fbref-cnpg-staging
#   garage bucket allow --read --write homelab-staging-fbref --key fbref-cnpg-staging
# Then put the key id + secret below and encrypt in place:  sops -e -i <this file>
apiVersion: v1
kind: Secret
metadata:
  name: garage-backup-credentials
type: Opaque
stringData:
  ACCESS_KEY_ID: "<garage key id>"
  ACCESS_KEY_SECRET: "<garage secret key>"
