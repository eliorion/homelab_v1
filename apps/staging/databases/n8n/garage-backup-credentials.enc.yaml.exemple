# Pristine plaintext template, never applied. Edit the WORKING file next to it
# (garage-backup-credentials.enc.yaml) and `sops -e -i` it. See README.md.
apiVersion: v1
kind: Secret
metadata:
  name: garage-backup-credentials
  namespace: n8n
type: Opaque
stringData:
  ACCESS_KEY_ID: "<garage key id>"
  ACCESS_KEY_SECRET: "<garage secret key>"
