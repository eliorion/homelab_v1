# Pristine template. Same convention as apps/staging/databases/fbref/.
#
# The working file next to this one -- garage-backup-credentials.enc.yaml --
# ships with PLACEHOLDER values so it can be edited directly in the devcontainer.
# Once you `sops -e -i` it, its values become unreadable; this file stays behind
# as the human-readable record of which keys exist and how to mint them.
#
# Other project keys do NOT have n8n access -- create a dedicated bucket + key:
#   garage bucket create cnpg-staging-n8n
#   garage key create n8n-cnpg-staging
#   garage bucket allow --read --write cnpg-staging-n8n --key n8n-cnpg-staging
#
# Then edit the WORKING file (not this one) and encrypt it in place:
#   sops -e -i garage-backup-credentials.enc.yaml
#   grep -q 'ENC\[' garage-backup-credentials.enc.yaml && echo SAFE || echo PLAINTEXT
#
# Finally uncomment the backup block in kustomization.yaml -- but only after the
# real key is in; see the note there about stalling the app tier.
apiVersion: v1
kind: Secret
metadata:
  name: garage-backup-credentials
  namespace: n8n
type: Opaque
stringData:
  ACCESS_KEY_ID: "<garage key id>"
  ACCESS_KEY_SECRET: "<garage secret key>"
