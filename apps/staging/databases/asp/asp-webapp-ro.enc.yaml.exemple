# PLACEHOLDER -- NOT ENCRYPTED YET, and not applied: Flux never sees a file the
# kustomization does not list, and `asp-webapp-ro.enc.yaml` is what it lists.
#
# Password for the `webapp_ro` CNPG managed role (declared in
# apps/base/databases/asp/database.yaml). CNPG creates the login from these two
# fields and the asp chart builds the webapp's DSN from the same Secret:
#   postgresql://$(DB_USER):$(DB_PASSWORD)@asp-db-r:5432/automarket
#
# `username` MUST equal the role name — CNPG matches the managed role by it, and
# a mismatch authenticates as nobody.
#
# HOW TO TURN THIS INTO THE REAL FILE
#   cd <homelab_v1>
#   cp  apps/staging/databases/asp/asp-webapp-ro.enc.yaml.exemple \
#       apps/staging/databases/asp/asp-webapp-ro.enc.yaml
#   # put a generated password in it:
#   openssl rand -base64 30
#   sops -e -i apps/staging/databases/asp/asp-webapp-ro.enc.yaml
#
# No sops flags are needed: .sops.yaml matches this path on
# `(^|/)staging/.*\.enc\.ya?ml$` and picks the staging age recipient
# (age137z0k38fp0keu5ns4005e7cv4qlwt320wyf96y48a57sv42k6v9szh5ng3) itself. Its
# `encrypted_regex: ^(data|stringData)$` means ONLY the two values below are
# encrypted — apiVersion/kind/metadata stay readable in git, which is why a diff
# on this file still shows what it is. Encrypting the whole document instead
# would make the kustomization unable to see the Secret's name.
#
# THIS .exemple FILE STAYS PLAINTEXT ON PURPOSE: the sops rule is anchored on
# `.enc.yaml` at the END of the name, so the `.exemple` suffix keeps it out of
# both the encryption rule and the kustomization. Same convention as
# apps/staging/databases/fbref/garage-backup-credentials.enc.yaml.exemple.
#
# Rotating later: put a new password in, `sops -e -i` again, commit. CNPG applies
# it to the role and restarts nothing; the webapp picks it up on its next pod
# start (env var), so roll the Deployment if you want it immediate.
apiVersion: v1
kind: Secret
metadata:
  name: asp-webapp-ro
  namespace: asp
type: kubernetes.io/basic-auth
stringData:
  username: "webapp_ro"
  password: "<paste the generated password here>"
