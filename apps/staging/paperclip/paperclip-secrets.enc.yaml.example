# TEMPLATE — NOT ENCRYPTED. Never applied; copy it, fill it in, then
# `sops -e -i` the copy (staging age key, see ../../../.sops.yaml).
#
# Do NOT add ANTHROPIC_API_KEY: it overrides the subscription token.
# See ../../base/paperclip/README.md.
apiVersion: v1
kind: Secret
metadata:
  name: paperclip-secrets
  namespace: paperclip
type: Opaque
stringData:
  BETTER_AUTH_SECRET: "<openssl rand -hex 32>"
  CLAUDE_CODE_OAUTH_TOKEN: "<claude setup-token>"
