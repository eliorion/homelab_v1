# TEMPLATE — master key that encrypts every secret Paperclip stores in paperclip-db
# (AI connections, company secrets). Procedure in ../../base/paperclip/README.md.
#
# .sops.yaml selects the age key by PATH (`staging/*.enc.yaml`), so `.exemple` matches nothing
# and is never encrypted — NEVER put the real key here.
#   cp paperclip-secrets-key.enc.yaml.exemple paperclip-secrets-key.enc.yaml
#   # replace PAPERCLIP_SECRETS_MASTER_KEY with the output of `openssl rand -hex 32`
#   sops -e -i paperclip-secrets-key.enc.yaml
#
# NEVER ROTATE IT once Paperclip has stored a secret: a paperclip-db restore without this
# exact key leaves every stored credential unreadable.
apiVersion: v1
kind: Secret
metadata:
  name: paperclip-secrets-key
  namespace: paperclip
type: Opaque
stringData:
  PAPERCLIP_SECRETS_MASTER_KEY: REPLACE_WITH_OPENSSL_RAND_HEX_32
