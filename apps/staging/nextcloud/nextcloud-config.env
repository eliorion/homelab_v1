# Packed into the nextcloud-config ConfigMap by configMapGenerator, so the
# content hash is part of the name and editing this file rolls the Deployment.
# These are consumed with envFrom, i.e. read once at pod start — a plain
# ConfigMap would update in place and change nothing until the pod restarted.
#
# No quotes: an env file takes the rest of the line literally, quotes included.

# `localhost` is here for the kubelet probes (they send Host: localhost).
NEXTCLOUD_TRUSTED_DOMAINS=staging-nextcloud.eliorion.fr localhost
# Cluster pod CIDR (bootstraping/talconfig.yaml). cloudflared terminates the
# tunnel here, so without this every client shows up as the cloudflared pod IP.
TRUSTED_PROXIES=10.244.0.0/16
# TLS ends at the Cloudflare edge; the in-cluster hop is plain HTTP. Without
# these three Nextcloud emits http:// asset URLs and the browser blocks them.
OVERWRITEPROTOCOL=https
OVERWRITEHOST=staging-nextcloud.eliorion.fr
OVERWRITECLIURL=https://staging-nextcloud.eliorion.fr
PHP_MEMORY_LIMIT=1G
PHP_UPLOAD_LIMIT=4G

# Read by the before-starting hook (apps/base/nextcloud/oidc-hook.sh).
OIDC_PROVIDER_ID=Keycloak
# Must equal the clientId in the staging-apps realm.
OIDC_CLIENT_ID=nextcloud
# The realm segment must equal APPS_REALM in
# infrastructure/services/staging/keycloak/realm/realm-vars.yaml. The PUBLIC
# issuer, deliberately: Keycloak's networkPolicy.https admits only the
# `cloudflare` and `identity` namespaces, so this pod cannot reach
# keycloak-service:8443 at all. The backchannel hairpins out through the tunnel
# and back — Nextcloud logins therefore depend on the tunnel being up.
OIDC_DISCOVERY_URI=https://staging-keycloak.eliorion.fr/realms/staging-apps/.well-known/openid-configuration

# Primary storage is the SeaweedFS `nextcloud` bucket. Path style is mandatory:
# the S3 gateway serves no per-bucket DNS, so virtual-host addressing resolves
# to nothing. AUTOCREATE stays false — the bucket is created by the
# infra-seaweedfs-config Job, which also sets its volume growth.
OBJECTSTORE_S3_BUCKET=nextcloud
OBJECTSTORE_S3_HOST=seaweedfs-seaweedfs-s3.seaweedfs.svc.cluster.local
OBJECTSTORE_S3_PORT=8333
OBJECTSTORE_S3_SSL=false
OBJECTSTORE_S3_REGION=us-east-1
OBJECTSTORE_S3_USEPATH_STYLE=true
OBJECTSTORE_S3_AUTOCREATE=false
