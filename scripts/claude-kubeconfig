#!/usr/bin/env bash
# Issue the Claude Code agent's own kubeconfig: ServiceAccount claude-agent/claude-agent
# (infrastructure/services/base/claude-agent), a short-lived token, mode 600.
# Usage: mise claude-kubeconfig [duration, default 168h] — run it with an ADMIN kubeconfig.
set -euo pipefail

duration=${1:-168h}
out=${CLAUDE_KUBECONFIG:-$HOME/.kube/claude-agent.yaml}

server=$(kubectl config view --minify --raw -o jsonpath='{.clusters[0].cluster.server}')
ca=$(kubectl config view --minify --raw -o jsonpath='{.clusters[0].cluster.certificate-authority-data}')
token=$(kubectl -n claude-agent create token claude-agent --duration="$duration")

mkdir -p "$(dirname "$out")"
( umask 077 && cat >"$out" <<KUBECONFIG
apiVersion: v1
kind: Config
clusters:
  - name: staging
    cluster:
      server: ${server}
      certificate-authority-data: ${ca}
users:
  - name: claude-agent
    user:
      token: ${token}
contexts:
  - name: claude-agent@staging
    context:
      cluster: staging
      user: claude-agent
current-context: claude-agent@staging
KUBECONFIG
)
unset token
echo "wrote $out (expires in $duration)"
KUBECONFIG=$out kubectl auth whoami -o jsonpath='{.status.userInfo.username}{"\n"}'
