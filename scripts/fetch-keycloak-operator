#!/usr/bin/env bash
# Re-vendor the Keycloak operator release manifests.
#
# The Keycloak project ships no Helm chart for the operator, so the manifests
# live in git under infrastructure/controllers/base/keycloak-operator/upstream/.
# This script is the ONLY supported way to change them: hand-editing a vendored
# CRD makes the next bump an unreviewable diff.
#
#   scripts/fetch-keycloak-operator 26.7.0
#
# Afterwards the Keycloak CR's `spec.image` tag must be bumped to match — the
# operator and the server it manages are released together, and a mismatch is
# not a supported combination.
set -euo pipefail

VERSION="${1:-}"
if [[ -z "$VERSION" ]]; then
  echo "usage: $(basename "$0") <version>   e.g. 26.7.0" >&2
  exit 2
fi

ROOT="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
UNIT="$ROOT/infrastructure/controllers/base/keycloak-operator"
BASE="https://raw.githubusercontent.com/keycloak/keycloak-k8s-resources/${VERSION}/kubernetes"

# Upstream names these `.yml`; there is no `.yaml` to fetch, that URL 404s.
# They land here as `.yaml` to match every other manifest in the repo. Only the
# extension changes — the content is byte-identical to upstream, so a bump stays
# a reviewable diff. kustomization.yaml lists the `.yaml` names.
FILES=(
  keycloakoidcclients.k8s.keycloak.org-v1.yml
  keycloakrealmimports.k8s.keycloak.org-v1.yml
  keycloaks.k8s.keycloak.org-v1.yml
  keycloaksamlclients.k8s.keycloak.org-v1.yml
  kubernetes.yml
)

# Download to a temp dir first: a 404 on the last file must not leave the unit
# half-bumped, which would deploy a new operator against old CRDs.
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
for f in "${FILES[@]}"; do
  curl -sSfL -o "$TMP/$f" "$BASE/$f"
done

mkdir -p "$UNIT/upstream"
for f in "${FILES[@]}"; do
  mv "$TMP/$f" "$UNIT/upstream/${f%.yml}.yaml"
done

# An older checkout vendored these under their upstream `.yml` names. Leaving
# both around would apply every CRD twice, so drop the stale copies.
rm -f "$UNIT"/upstream/*.yml

sed -i "s|^# keycloakOperatorVersion: .*|# keycloakOperatorVersion: ${VERSION}|" "$UNIT/kustomization.yaml"

echo "vendored keycloak-operator ${VERSION}"
grep -n 'image: quay.io/keycloak/keycloak-operator' "$UNIT/upstream/kubernetes.yaml"
echo "NOW: bump spec.image in infrastructure/services/base/keycloak/app/keycloak.yaml to ${VERSION}"
