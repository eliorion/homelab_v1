# cp .env.example .env  — then fill in and keep .env off git.

# Tailnet name of the master, from the azuracast-stream Service (tailscale status).
MASTER_HOST=azuracast-stream.tailXXXXXX.ts.net
MASTER_PORT=8000
MOUNT=/radio.mp3

# What listeners type. Used in Icecast's own generated URLs.
RELAY_PUBLIC_HOST=radio.example.com

# THE SPEND CONTROL, not a performance setting: ~65 GB/month per occupied slot.
# Check the product against the plan's transfer allowance BEFORE raising it.
MAX_CLIENTS=50

# openssl rand -base64 24
ADMIN_PASSWORD=
SOURCE_PASSWORD=
RELAY_PASSWORD=
