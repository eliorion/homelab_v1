# cp .env.example .env  — then fill in and keep .env off git.

# The master's tailnet name. Comes from the azuracast-stream Service; find it
# with `tailscale status` once the operator has registered the device.
MASTER_HOST=azuracast-stream.tailXXXXXX.ts.net
MASTER_PORT=8000
MOUNT=/radio.mp3

# What listeners type. Used in Icecast's own generated URLs.
RELAY_PUBLIC_HOST=radio.example.com

# THE SPEND CONTROL, not a performance setting. One continuously-occupied slot
# is ~65 GB of transfer per month. Multiply this number by 65 GB and check the
# answer against the plan's allowance BEFORE raising it:
#
#     50 slots  -> up to  3.3 TB/month
#    100 slots  -> up to  6.5 TB/month
#   1000 slots  -> up to   65 TB/month
MAX_CLIENTS=50

# openssl rand -base64 24
ADMIN_PASSWORD=
SOURCE_PASSWORD=
RELAY_PASSWORD=
